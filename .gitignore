# --- Secrets and credentials -----------------------------------------------
# Nothing in this section may ever reach a commit.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# Session cookies and auth artifacts
cookies.txt
cookies.json
*.cookie
*_cookies*

# Proxy lists (often contain credentials in the URL)
proxies.txt
proxies*.txt
!proxies.example.txt

# --- Collected personal data -----------------------------------------------
# Exports contain personal information about real people. Keep them local.
exports/
demo_output/
*.csv
!tests/**/*.csv
!docs/**/*.csv

# --- Logs -------------------------------------------------------------------
*.log
logs/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
env/
venv/
.venv/
ENV/

# --- Tooling caches ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Databases --------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Agent tooling ----------------------------------------------------------
.claude/
