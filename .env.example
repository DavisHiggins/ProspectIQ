# ProspectIQ configuration
#
# Copy to .env and edit. .env is gitignored — never commit real values.
# Every setting is optional; ProspectIQ runs with none of them set.

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# LinkedIn session cookie (li_at). This is YOUR OWN session, exported from a
# browser where you are already logged in. ProspectIQ never asks for, collects,
# or transmits your LinkedIn password.
#
#   DevTools (F12) > Application > Cookies > linkedin.com > li_at
#
# Treat this like a password: it grants access to your account. Rotate it by
# logging out, which invalidates the session.
# PROSPECTIQ_LINKEDIN_COOKIE=

# Hunter.io API key (optional). Adds a supplemental email-finding source.
# PROSPECTIQ_HUNTER_API_KEY=

# ---------------------------------------------------------------------------
# Request pacing
# ---------------------------------------------------------------------------

# Random delay between requests, in seconds. Defaults to 2.0-5.0.
# Lowering these increases the chance of being rate limited or blocked, and
# raises the load you place on the source. Raise them, do not lower them.
# PROSPECTIQ_DELAY_MIN=2.0
# PROSPECTIQ_DELAY_MAX=5.0

# ---------------------------------------------------------------------------
# Proxy (optional — every source works without one)
# ---------------------------------------------------------------------------

# A single proxy URL.
# PROSPECTIQ_PROXY=http://user:pass@host:port

# A file of proxies, one per line, rotated at random. Keep it out of git.
# PROSPECTIQ_PROXY_FILE=proxies.txt

# Use free public proxies. Unreliable and slow; not recommended.
# PROSPECTIQ_FREE_PROXY=false

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Directory for CSV exports. Defaults to ./exports
# PROSPECTIQ_OUTPUT_DIR=exports

# Attempt SMTP existence checks on email candidates. Defaults to true.
# Set to false to skip all SMTP traffic.
# PROSPECTIQ_SMTP_VERIFY=true

# Check GitHub for a newer release on startup. Opt-in, defaults to false.
# ProspectIQ makes no outbound request for this unless you enable it.
# PROSPECTIQ_UPDATE_CHECK=false

# Standard NO_COLOR support: set to any value to disable colored output.
# NO_COLOR=1

# ---------------------------------------------------------------------------
# Deprecated
# ---------------------------------------------------------------------------
# The SCOUT_-prefixed spellings of PROXY, PROXY_FILE, FREE_PROXY, DELAY_MIN,
# and DELAY_MAX are still read as a fallback for users migrating from the
# upstream project. They emit a warning and will be removed in a future
# release — rename them to PROSPECTIQ_.
