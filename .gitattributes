# Normalize line endings so the repository stays consistent across platforms
# and `ruff format --check` cannot fail in CI purely because of CRLF.

* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.svg binary

# Keep generated and vendored files out of language statistics and diffs.
docs/assets/* linguist-documentation
